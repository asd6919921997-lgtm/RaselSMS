<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvModalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إشعار غياب كامل المدرسة لهذا اليوم"
            android:textColor="#C62828"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvModalSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="تم تجميع كافة الطلاب الغائبين في جميع الصفوف والشعب المرصودة."
            android:textColor="#546E7A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvAbsentSummaryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/badge_bg"
            android:backgroundTint="#FFEBEE"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="إجمالي الغائبين: 0 طالب"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- تحكم بنص الرسالة يدوياً لتوفير الرصيد -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="نص رسالة الغياب (تحكم يدوي لتقصير الرسالة وتوفير الرصيد):"
            android:textColor="#263238"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="اكتب نص رسالة الغياب هنا..."
            app:boxBackgroundMode="outline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAbsentCustomMessage"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:text="نحيطكم علماً بغياب نجلكم الطالب {الاسم} عن الدوام اليوم." />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- عداد الحروف والشرائح الذكي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAbsentCharCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="الحروف: 52 | الأجزاء: 1 رسالة (70 حرف)"
                android:textColor="#1565C0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInsertNamePlaceholder"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ {الاسم}"
                android:textColor="#2E7D32"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- اختيار الشريحة والفاصل الزمني -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الشريحة المستخدمة:"
                    android:textColor="#455A64"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spnModalSim"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/rounded_edittext" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الفاصل الزمني الآمن:"
                    android:textColor="#455A64"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spnModalDelay"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/rounded_edittext" />
            </LinearLayout>
        </LinearLayout>

        <!-- أزرار الإجراء -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelModal"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="إلغاء"
                android:textColor="#78909C"
                app:strokeColor="#B0BEC5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartSendingAbsent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginStart="6dp"
                android:backgroundTint="#C62828"
                android:text="بدء إرسال الغياب للكل"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
